pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'bookmyshow-event'
        IMAGE_TAG = '1.2'
        APP_DIR = 'bookmyshow-app'
        K8S_NAMESPACE = 'bookmyshow-ci'
        K8S_API = 'https://172.18.0.5:6443'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${APP_NAME}:${IMAGE_TAG} bookmyshow-app'
            }
        }

        stage('Load Image into Kind') {
            steps {
                sh 'kind load docker-image ${APP_NAME}:${IMAGE_TAG} --name bookmyshow-cluster'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([string(credentialsId: 'k8s-jenkins-token', variable: 'K8S_TOKEN')]) {
                    sh '''
                        kubectl --server="${K8S_API}" \
                          --certificate-authority=/tmp/k8s-ca.crt \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          apply --validate=false -f "bookmyshow-app/k8s/deployment.yaml"
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withCredentials([string(credentialsId: 'k8s-jenkins-token', variable: 'K8S_TOKEN')]) {
                    sh '''
                        kubectl --server="${K8S_API}" \
                          --certificate-authority=/tmp/k8s-ca.crt \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          rollout status deployment/bookmyshow --timeout=120s

                        kubectl --server="${K8S_API}" \
                          --certificate-authority=/tmp/k8s-ca.crt \
                          --token="$K8S_TOKEN" \
                          -n "$K8S_NAMESPACE" \
                          get pods,services
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'BookMyShow CI/CD pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}

